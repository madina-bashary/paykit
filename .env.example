# The library itself needs no environment. This file mirrors apps/demo so the
# repo root shows what a paykit integration requires.
#
# Copy apps/demo/.env.example to apps/demo/.env.local to run the demo.
# TEST / SANDBOX credentials only. .env* is gitignored.

NEXT_PUBLIC_STRIPE_PK=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx

NEXT_PUBLIC_PAYPAL_CLIENT_ID=sandbox_client_id
PAYPAL_CLIENT_ID=sandbox_client_id
PAYPAL_SECRET=sandbox_secret

NEXT_PUBLIC_GOOGLE_PAY_MERCHANT_ID=TEST_MERCHANT
NEXT_PUBLIC_GOOGLE_PAY_MERCHANT_NAME=paykit demo

# ---------------------------------------------------------------------------
# Copy to .env.local and fill in TEST/SANDBOX credentials only.
# .env* is gitignored. Never put a live key in this repo.
# ---------------------------------------------------------------------------

# Stripe — https://dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_PK=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx

# PayPal — https://developer.paypal.com/dashboard/applications/sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=sandbox_client_id
PAYPAL_CLIENT_ID=sandbox_client_id
PAYPAL_SECRET=sandbox_secret

# Google Pay — TEST merchant id works without registration.
# Tokens are processed through the Stripe keys above.
NEXT_PUBLIC_GOOGLE_PAY_MERCHANT_ID=TEST_MERCHANT
NEXT_PUBLIC_GOOGLE_PAY_MERCHANT_NAME=paykit demo

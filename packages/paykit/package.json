{
  "name": "paykit",
  "version": "0.1.0",
  "description": "One React component API for Stripe, PayPal and Google Pay. One result type, one error type, one state machine.",
  "license": "MIT",
  "author": "Madina Bashary",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madina-bashary/paykit.git",
    "directory": "packages/paykit"
  },
  "homepage": "https://github.com/madina-bashary/paykit#readme",
  "bugs": "https://github.com/madina-bashary/paykit/issues",
  "keywords": [
    "payments",
    "stripe",
    "paypal",
    "google-pay",
    "react",
    "nextjs",
    "typescript",
    "checkout"
  ],
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./next/server": {
      "types": "./dist/next/server.d.ts",
      "import": "./dist/next/server.mjs",
      "require": "./dist/next/server.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && node scripts/check-build.mjs",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepack": "node scripts/copy-docs.mjs"
  },
  "dependencies": {
    "server-only": "0.0.1"
  },
  "peerDependencies": {
    "@paypal/paypal-js": ">=8",
    "@stripe/stripe-js": ">=5",
    "react": ">=18",
    "stripe": ">=17"
  },
  "peerDependenciesMeta": {
    "@paypal/paypal-js": {
      "optional": true
    },
    "@stripe/stripe-js": {
      "optional": true
    },
    "stripe": {
      "optional": true
    }
  },
  "devDependencies": {
    "@paypal/paypal-js": "11.1.0",
    "@stripe/stripe-js": "9.16.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "stripe": "22.6.2",
    "tsup": "8.5.1",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
